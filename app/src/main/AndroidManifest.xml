<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required so the user-confirmed PackageInstaller session can proceed after the
         user taps "Download & install" and accepts the system install prompt.
         The app never installs silently; the system installer always asks first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <!-- App tiles must be visible to the label guard on Android 11+.
             Limit discovery to launchable apps; no QUERY_ALL_PACKAGES permission. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nuvio" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="stremio" />
        </intent>
        <!-- WuPlay's own scheme; without this the handler is invisible to
             queryIntentActivities on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="wuplay" />
        </intent>
        <package android:name="app.wuplay.androidtv" />
        <package android:name="org.smarttube.stable" />
        <package android:name="org.smarttube.beta" />
        <package android:name="com.teamsmart.videomanager.tv" />
        <package android:name="com.liskovsoft.smartyoutubetv2.beta" />
        <package android:name="io.gh.reisxd.tizentube.cobalt" />
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/gtv2stream_logo"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:label="@string/help_title" />

        <receiver
            android:name=".UpdateInstallReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.gtv2stream.UPDATE_INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <service
            android:name=".TvRecommendationService"
            android:description="@string/service_description"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
