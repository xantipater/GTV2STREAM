<?xml version="1.0" encoding="utf-8"?>
<!-- High-contrast focus state for D-pad navigation at 10 feet: the focused
    button fills with the accent colour plus a white edge, while the resting
    state stays a neutral dark panel. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#73A7FF" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#73A7FF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2A3344" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
